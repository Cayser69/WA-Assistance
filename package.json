{
  "name": "wa-sales-assistant",
  "version": "1.0.0",
  "description": "WhatsApp Cold Sales Assistant for Windows",
  "main": "src/main/index.js",
  "type": "module",
  "scripts": {
    "start": "chcp 65001 > nul && .\\node_modules\\electron\\dist\\electron.exe src/main/index.js",
    "start:debug": "set DEBUG=true&& chcp 65001 > nul && .\\node_modules\\electron\\dist\\electron.exe src/main/index.js",
    "test-db": "chcp 65001 > nul && node test-db.js",
    "test-ai": "node test-ai.js",
    "dist:win": "electron-builder build --win",
    "dist:portable": "electron-builder build --win portable",
    "dist:nsis": "electron-builder build --win nsis",
    "postinstall": "electron-builder install-app-deps"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/Cayser69/WA-Assistance.git"
  },
  "nodemonConfig": {
    "ignore": [
      ".wwebjs_auth/*",
      "src/renderer/*"
    ],
    "delay": "2500"
  },
  "dependencies": {
    "electron-updater": "^6.8.3",
    "openai": "^6.33.0",
    "qrcode": "^1.5.3",
    "sqlite3": "^5.1.0",
    "whatsapp-web.js": "^1.23.0"
  },
  "devDependencies": {
    "electron": "^30.0.0",
    "electron-builder": "^26.8.1",
    "nodemon": "^3.1.14"
  },
  "build": {
    "appId": "com.cayser.wa-assistance",
    "productName": "WA-Assistance",
    "asar": false,
    "directories": {
      "output": "dist"
    },
    "win": {
      "target": [
        "nsis",
        "portable"
      ],
      "icon": "assets/icon.ico"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "shortcutName": "WA-Assistance",
      "artifactName": "${productName}-Setup-${version}.${ext}"
    },
    "portable": {
      "artifactName": "${productName}-Portable-${version}.${ext}"
    },
    "publish": {
      "provider": "github",
      "owner": "Cayser69",
      "repo": "WA-Assistance"
    }
  }
}
